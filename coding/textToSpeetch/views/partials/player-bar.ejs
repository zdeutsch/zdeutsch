<div id="player-bar" class="player-bar hidden">
  <div class="player-bar__info">
    <span class="player-bar__label">Now Playing</span>
    <div class="player-bar__title" id="player-title">No audio selected</div>
    <div class="player-bar__meta" id="player-context"></div>
  </div>
  <div class="player-bar__controls">
    <button id="player-rewind" class="player-seek player-seek--back" type="button" title="Back 10s" aria-label="Back 10 seconds">
      <span class="seek-arrow"><<</span>
    </button>
    <button id="player-toggle" class="player-bar__button" type="button" aria-label="Play or pause">▶</button>
    <button id="player-forward" class="player-seek player-seek--fwd" type="button" title="Forward 10s" aria-label="Forward 10 seconds">
      <span class="seek-arrow">>></span>
    </button>
    <div class="player-bar__timeline">
      <span id="player-current" class="player-bar__time">0:00</span>
      <input type="range" id="player-progress" min="0" max="0" step="0.1" value="0">
      <span id="player-duration" class="player-bar__time">0:00</span>
    </div>
    <div class="player-bar__speed">
      <select id="player-speed" title="Playback speed">
        <option value="0.5">0.5×</option>
        <option value="0.75">0.75×</option>
        <option value="1" selected>1×</option>
        <option value="1.25">1.25×</option>
        <option value="1.5">1.5×</option>
        <option value="1.75">1.75×</option>
        <option value="2">2×</option>
      </select>
    </div>
  </div>
</div>

